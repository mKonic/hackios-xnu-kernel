+			redwood_touch_post_at(REDWOOD_TOUCH_DOWN, (uint32_t)i, d->contact[i].x, d->contact[i].y, when);
 		} else if (down && d->contact[i].moved) {
-			redwood_touch_post(REDWOOD_TOUCH_MOVE, (uint32_t)i, d->contact[i].x, d->contact[i].y);
+			redwood_touch_post_at(REDWOOD_TOUCH_MOVE, (uint32_t)i, d->contact[i].x, d->contact[i].y, when);
 		} else if (!down && d->contact[i].down) {
-			redwood_touch_post(REDWOOD_TOUCH_UP, (uint32_t)i, d->contact[i].x, d->contact[i].y);
+			redwood_touch_post_at(REDWOOD_TOUCH_UP, (uint32_t)i, d->contact[i].x, d->contact[i].y, when);
 		}
 		d->contact[i].down = down;
 		d->contact[i].moved = false;
@@ -324,12 +366,19 @@ input_event(struct input_device *d, const struct input_event *e)
 			redwood_touch_post(e->value ? REDWOOD_BUTTON_DOWN : REDWOOD_BUTTON_UP, button, 0, 0);
 		}
 		break;
+	case EV_MSC:
+		if (e->code == MSC_TIMESTAMP) {
