diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 29978e9..1e64e96 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -686,7 +686,8 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	// A memory-device root needs no filesystem kext, so do not sit out the timeout for one
 	char rdEarly[kMaxBootVar];
 	uint64_t bsdWait = 30ULL * kSecondScale;
-	if (PE_parse_boot_argn("rd", rdEarly, sizeof(rdEarly)) && rdEarly[0] == 'm' && rdEarly[1] == 'd') {
+	if (PE_parse_boot_argn("rd", rdEarly, sizeof(rdEarly)) &&
+	    ((rdEarly[0] == 'm' && rdEarly[1] == 'd') || strncmp(rdEarly, "rvblk", 5) == 0)) {
 		bsdWait = kSecondScale / 10;
 	}
 
@@ -784,6 +785,23 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 		}
 	}
 
+//
+//	A virtio disk (bsd/dev/redwood_virtio_blk.c): rd=rvblk0 roots on the first one
+//
+	if (strncmp(rdBootVar, "rvblk", 5) == 0) {
+		extern int redwood_virtio_blk_rootdev(const char *name, dev_t *dev);
+		int vblk_error;
+
+		OSSafeReleaseNULL(matching);
+		if ((vblk_error = redwood_virtio_blk_rootdev(rdBootVar, root)) != 0) {
+			panic("IOFindBSDRoot: virtio root %s unavailable: %d", rdBootVar, vblk_error);
+		}
+		strlcpy(rootName, rdBootVar, rootNameSize);
+		IOLog("BSD root: %s, major %d, minor %d\n", rootName, major(*root), minor(*root));
+		*oflags = 0;
+		goto iofrootx;
+	}
+
 //
 //	Now check if we are trying to root on a memory device
 //
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 997a4ab..c7a9f81 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -697,6 +697,27 @@ register_serial_functions(struct pe_serial_functions *fns)
 	gPESF = fns;
 }
 
+/*
+ * A virtio console (port 0 of the first virtio-console device, over virtio-pci or
+ * virtio-mmio): bsd/dev/redwood_virtio_console.c. For virtual machines without a UART.
+ */
+extern bool redwood_vcon_probe(bool other);
+extern void redwood_vcon_init(void);
+extern unsigned int redwood_vcon_transmit_ready(void);
+extern void redwood_vcon_transmit_data(uint8_t c);
+extern unsigned int redwood_vcon_receive_ready(void);
+extern uint8_t redwood_vcon_receive_data(void);
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) virtio_console_serial_functions =
+{
+	.init = redwood_vcon_init,
+	.transmit_ready = redwood_vcon_transmit_ready,
+	.transmit_data = redwood_vcon_transmit_data,
+	.receive_ready = redwood_vcon_receive_ready,
+	.receive_data = redwood_vcon_receive_data,
+	.device = SERIAL_VIRTIO_CONSOLE
+};
+
 #if HIBERNATION
 /**
  * Transitions the serial driver into a mode that can be run in the hibernation
@@ -897,6 +918,10 @@ serial_init(void)
 	}
 #endif /* APPLE_UART */
 
+	if (redwood_vcon_probe(gPESF != NULL)) {
+		register_serial_functions(&virtio_console_serial_functions);
+	}
+
 	if (gPESF == NULL) {
 		return 0;
 	}
