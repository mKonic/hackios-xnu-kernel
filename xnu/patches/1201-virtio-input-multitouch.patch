+/* QEMU's tablet range until the device says otherwise; no contacts */
+static void
+input_defaults(struct input_device *d)
+{
+	d->ax = d->ay = d->mtx = d->mty = (struct axis){ 0, ABS_RANGE };
+	for (int i = 0; i < MT_SLOTS; i++) {
+		d->contact[i].id = -1;
+	}
+}
