+	uint32_t res = 0, width = 0, height = 0;
+	int err;
+
+	lck_mtx_lock(&vgpu3d_opens_lock);
+	for (int i = 0; sid && i < MAX_NAMED; i++) {
+		if (named[i].sid == sid) {
+			res = named[i].res, width = named[i].width, height = named[i].height;
+		}
+	}
+	lck_mtx_unlock(&vgpu3d_opens_lock);
+	if (res == 0) {
+		return ENOENT;
+	}
+	err = redwood_vgpu_show(res, width, height);
+	if (err == 0) {
+		lck_mtx_lock(&vgpu3d_opens_lock);
+		for (int i = 0; i < MAX_NAMED; i++) {
+			named[i].shown |= named[i].sid == sid && named[i].res == res;
+		}
