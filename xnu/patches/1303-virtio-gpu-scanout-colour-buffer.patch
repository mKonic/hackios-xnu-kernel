+
+static void
+named_forget(uint32_t res)
+{
+	lck_mtx_lock(&vgpu3d_opens_lock);
+	for (int i = 0; i < MAX_NAMED; i++) {
+		if (named[i].res == res) {
+			bzero(&named[i], sizeof(named[i]));
+		}
+	}
+	lck_mtx_unlock(&vgpu3d_opens_lock);
