+/* ---- the display: colour buffers that are IOSurfaces ------------------------------------- */
+
+#define MAX_NAMED               16
+static struct {
+	uint32_t sid, res, width, height;
+	bool shown;                             /* by the display as it is: its memory is not kept up to date */
+	struct vopen *o;
+	struct res *r;
+} named[MAX_NAMED];                             /* (under vgpu3d_opens_lock) */
+
+static void
+named_forget(uint32_t res)
+{
+	lck_mtx_lock(&vgpu3d_opens_lock);
+	for (int i = 0; i < MAX_NAMED; i++) {
+		if (named[i].res == res) {
+			bzero(&named[i], sizeof(named[i]));
+		}
+	}
+	lck_mtx_unlock(&vgpu3d_opens_lock);
+}
+
+static int
+res_name(struct vopen *o, const struct vgpu3d_ioc_name *n)
+{
+	struct res *r = res_find(o, n->res);
+	int slot = -1;
+
+	if (r == NULL || n->sid == 0) {
+		return ENOENT;
+	}
+	lck_mtx_lock(&vgpu3d_opens_lock);
+	for (int i = 0; i < MAX_NAMED; i++) {
+		if (named[i].sid == n->sid || named[i].res == n->res) {
+			bzero(&named[i], sizeof(named[i]));
+		}
+		slot = slot < 0 && named[i].sid == 0 ? i : slot;
+	}
+	if (slot >= 0) {
+		named[slot].sid = n->sid;
+		named[slot].res = r->id;
+		named[slot].width = r->width;
+		named[slot].height = r->height;
+		named[slot].o = o;
+		named[slot].r = r;
+	}
+	lck_mtx_unlock(&vgpu3d_opens_lock);
+	return slot >= 0 ? 0 : ENOSPC;
+}
+
+int
+redwood_vgpu3d_show(uint32_t sid)
+{
+	uint32_t res = 0, width = 0, height = 0;
+	int err;
+
+	lck_mtx_lock(&vgpu3d_opens_lock);
+	for (int i = 0; sid && i < MAX_NAMED; i++) {
+		if (named[i].sid == sid) {
+			res = named[i].res, width = named[i].width, height = named[i].height;
+		}
+	}
+	lck_mtx_unlock(&vgpu3d_opens_lock);
+	if (res == 0) {
+		return ENOENT;
+	}
+	err = redwood_vgpu_show(res, width, height);
+	if (err == 0) {
+		lck_mtx_lock(&vgpu3d_opens_lock);
+		for (int i = 0; i < MAX_NAMED; i++) {
+			named[i].shown |= named[i].sid == sid && named[i].res == res;
+		}
+		lck_mtx_unlock(&vgpu3d_opens_lock);
+	}
+	return err;
+}
+
+/*
+ * A colour buffer the display has shown as it is has no copy in its IOSurface's memory: when that
+ * memory is to be read after all (a frame the display composes itself), the host's pixels are
+ * fetched into it first. The opens lock is held throughout, so the resource is not freed under it
+ * (res_free forgets the name first); the opener's own lock is not taken.
+ */
+int
+redwood_vgpu3d_fetch(uint32_t sid, void *dst, uint32_t stride)
+{
+	int err = ENOENT;
+
+	lck_mtx_lock(&vgpu3d_opens_lock);
+	for (int i = 0; sid && i < MAX_NAMED; i++) {
+		if (named[i].sid == sid && named[i].shown) {
+			struct res *r = named[i].r;
+			size_t pitch = (size_t)r->width * 4;
+			err = vgpu3d_transfer_box(&named[i].o->g, r->id, false, 0, 0, r->width, r->height, 0) ? EIO : 0;
+			named[i].o->g.err = 0;
+			for (uint32_t y = 0; err == 0 && y < r->height; y++) {
+				memcpy((uint8_t *)dst + (size_t)y * stride, (const uint8_t *)r->va + y * pitch, pitch);
+			}
+			break;
+		}
+	}
+	lck_mtx_unlock(&vgpu3d_opens_lock);
+	return err;
+}
+
+static int
+res_shown(uint32_t *res)
+{
+	uint32_t shown = 0;
+
+	lck_mtx_lock(&vgpu3d_opens_lock);
+	for (int i = 0; *res && i < MAX_NAMED; i++) {
+		shown |= named[i].res == *res && named[i].shown;
+	}
+	lck_mtx_unlock(&vgpu3d_opens_lock);
+	*res = shown;
+	return 0;
+}
+
 static void
 res_free(struct vopen *o, struct res *r)
 {
+	named_forget(r->id);
+	redwood_vgpu_forget(r->id);
 	vgpu3d_resource_unref(&o->g, r->id);
 	o->g.err = 0;
 	kmem_free(kernel_map, r->va, r->size);
