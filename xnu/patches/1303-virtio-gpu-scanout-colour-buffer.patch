+/*
+ * A colour buffer the display has shown as it is has no copy in its IOSurface's memory: when that
+ * memory is to be read after all (a frame the display composes itself), the host's pixels are
+ * fetched into it first. The opens lock is held throughout, so the resource is not freed under it
+ * (res_free forgets the name first); the opener's own lock is not taken.
+ */
+int
+redwood_vgpu3d_fetch(uint32_t sid, void *dst, uint32_t stride)
+{
+	int err = ENOENT;
+
+	lck_mtx_lock(&vgpu3d_opens_lock);
+	for (int i = 0; sid && i < MAX_NAMED; i++) {
+		if (named[i].sid == sid && named[i].shown) {
+			struct res *r = named[i].r;
+			size_t pitch = (size_t)r->width * 4;
+			err = vgpu3d_transfer_box(&named[i].o->g, r->id, false, 0, 0, r->width, r->height, 0) ? EIO : 0;
+			named[i].o->g.err = 0;
+			for (uint32_t y = 0; err == 0 && y < r->height; y++) {
+				memcpy((uint8_t *)dst + (size_t)y * stride, (const uint8_t *)r->va + y * pitch, pitch);
+			}
+			break;
+		}
+	}
+	lck_mtx_unlock(&vgpu3d_opens_lock);
+	return err;
+}
+
+static int
+res_shown(uint32_t *res)
+{
+	uint32_t shown = 0;
+
+	lck_mtx_lock(&vgpu3d_opens_lock);
+	for (int i = 0; *res && i < MAX_NAMED; i++) {
+		shown |= named[i].res == *res && named[i].shown;
+	}
+	lck_mtx_unlock(&vgpu3d_opens_lock);
+	*res = shown;
+	return 0;
+}
