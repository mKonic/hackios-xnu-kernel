+/*
+ * Put a 3D resource on the scanout, if it is not there, and flush it: the display shows the frame.
+ * (QEMU's rutabaga as tools/qemu/build.sh patches it keeps one picture per scanout and reads the
+ * flushed resource into it, so moving between CoreAnimation's two buffers every frame is cheap and
+ * shows nothing in between.) The flush is posted, not waited for.
+ */
+int
+redwood_vgpu_show(uint32_t resource, uint32_t width, uint32_t height)
+{
+	struct resource_flush flush = { .r = { 0, 0, width, height }, .resource_id = resource, .padding = 0 };
+	struct set_scanout scanout = { .r = { 0, 0, width, height }, .scanout_id = 0, .resource_id = resource };
+	int error = ENODEV;
+
+	lck_mtx_lock(&vgpu_lock);
+	if (vg.shown && width == vg.width && height == vg.height) {
+		error = 0;
+		if (vg.scanout_res != resource) {
+			error = vgpu_simple(&scanout, sizeof(scanout), CMD_SET_SCANOUT);
+			vg.scanout_res = error == 0 ? resource : vg.scanout_res;
+		}
+		if (error == 0) {
+			error = vgpu_post(&flush, sizeof(flush), CMD_RESOURCE_FLUSH);
+		}
+	}
+	lck_mtx_unlock(&vgpu_lock);
+	return error;
+}
+
+void
+redwood_vgpu_forget(uint32_t resource)
+{
+	lck_mtx_lock(&vgpu_lock);
+	if (vg.scanout_res == resource) {
+		vg.scanout_res = 0;     /* (the next frame puts something on again) */
+	}
+	lck_mtx_unlock(&vgpu_lock);
+}
