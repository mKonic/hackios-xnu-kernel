+/*
+ * Until the device has answered the command with this cookie (1: vgpu_submit's, 2: vgpu_post's).
+ * Most commands are answered in tens of microseconds, and 3D ones (a gfxstream pipe read waits for
+ * the host's render thread) in a few milliseconds. Interrupts may not come (polled), and a sleep is
+ * 10 ms at least: spin for the first 4 ms, then sleep a millisecond at a time. A read of the pipe
+ * may wait for long GPU work: give up after 20 s, not 2. Under vgpu_lock.
+ */
+static int
+vgpu_wait(void *cookie, uint32_t seq, uint32_t type)
+{
+	uint64_t now = mach_absolute_time(), spin_end, give_up;
+	uint32_t len;
+	void *done;
+
+	nanoseconds_to_absolutetime(4 * NSEC_PER_MSEC, &spin_end);
+	nanoseconds_to_absolutetime(20 * NSEC_PER_SEC, &give_up);
+	spin_end += now;
+	give_up += now;
+	for (;;) {
+		while ((done = vio_queue_get(vg.ctrlq, &len)) != NULL) {
+			if (done == (void *)2) {
+				vg.posted = false;
+				if (((struct ctrl_hdr *)vg.aresp)->type != RESP_OK_NODATA) {
+					printf("virtio-gpu: command 0x%x: answer 0x%x\n", ((struct ctrl_hdr *)vg.acmd)->type,
+					    ((struct ctrl_hdr *)vg.aresp)->type);
+				}
+			}
+			if (done == cookie) {
+				vio_intr_isr(vg.dev);
+				return 0;
+			}
+		}
+		now = mach_absolute_time();
+		if (now > give_up) {
+			printf("virtio-gpu: command 0x%x not answered\n", type);
+			return ETIMEDOUT;
+		}
+		if (now < spin_end) {
+			__asm__ volatile ("yield");
+			continue;
+		}
+		vio_intr_wait(vg.dev, seq, NSEC_PER_MSEC);
+		seq = vio_intr_seq(vg.dev);
+	}
+}
+
+/* The posted command answered, if there is one. Under vgpu_lock, device up. */
+static int
+vgpu_drain(void)
+{
+	return vg.posted ? vgpu_wait((void *)2, vio_intr_seq(vg.dev), ((struct ctrl_hdr *)vg.acmd)->type) : 0;
+}
