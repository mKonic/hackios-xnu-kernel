+		err = res_name(o, (struct vgpu3d_ioc_name *)data);
+		break;
+	case VGPU3D_IOC_SHOWN:
+		err = res_shown((uint32_t *)data);
+		break;
 	default:
 		err = ENOTTY;
 		break;
