+/*
+ * One command whose answer is just "OK", not waited for: the next command waits for it first (one
+ * in flight at most), and a refusal is only said. For a display flush, which QEMU answers once it
+ * has read the frame back and sent it to the display -- milliseconds the guest has better uses for.
+ */
+static int
+vgpu_post(void *cmd, uint32_t len, uint32_t type)
+{
+	struct vio_sg sg[2] = {
+		{ vg.acmd_pa, len, false },
+		{ vg.aresp_pa, sizeof(struct ctrl_hdr), true },
+	};
+	int error;
+
+	if (len > 256 || (error = vgpu_drain()) != 0) {
+		return len > 256 ? EINVAL : error;
+	}
+	bzero(cmd, sizeof(struct ctrl_hdr));
+	((struct ctrl_hdr *)cmd)->type = type;
+	memcpy(vg.acmd, cmd, len);
+	bzero(vg.aresp, sizeof(struct ctrl_hdr));
+	if (vio_queue_add(vg.ctrlq, sg, 2, (void *)2) != 0) {
+		return EIO;
+	}
+	vg.posted = true;
+	vio_queue_kick(vg.ctrlq);
+	return 0;
+}
