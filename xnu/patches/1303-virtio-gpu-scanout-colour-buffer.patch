+/*
+ * QEMU sends the display a resource's picture the moment it goes on the scanout, and a flush brings
+ * that picture up to date. A frame here is the other of the two buffers CoreAnimation draws in
+ * turn: put on first, it would show the frame before last until the flush -- a flicker on every
+ * frame that moves. So a buffer that has been on the scanout before (its picture exists on the host)
+ * is flushed first and then put on: what goes out is the new frame. The first time, it is the
+ * other way round (a flush needs the picture), once.
+ */
+int
+redwood_vgpu_show(uint32_t resource, uint32_t width, uint32_t height)
+{
+	struct resource_flush flush = { .r = { 0, 0, width, height }, .resource_id = resource, .padding = 0 };
+	struct set_scanout scanout = { .r = { 0, 0, width, height }, .scanout_id = 0, .resource_id = resource };
+	bool known = false;
+	int error = ENODEV;
+
+	lck_mtx_lock(&vgpu_lock);
+	if (vg.shown && width == vg.width && height == vg.height) {
+		for (int i = 0; i < 8; i++) {
+			known |= vg.been_shown[i] == resource;
+		}
+		if (vg.scanout_res == resource) {
+			error = vgpu_simple(&flush, sizeof(flush), CMD_RESOURCE_FLUSH);
+		} else if (known) {
+			error = vgpu_simple(&flush, sizeof(flush), CMD_RESOURCE_FLUSH);
+			if (error == 0) {
+				error = vgpu_simple(&scanout, sizeof(scanout), CMD_SET_SCANOUT);
+			}
+		} else {
+			error = vgpu_simple(&scanout, sizeof(scanout), CMD_SET_SCANOUT);
+			if (error == 0) {
+				error = vgpu_simple(&flush, sizeof(flush), CMD_RESOURCE_FLUSH);
+			}
+			if (error == 0) {
+				memmove(&vg.been_shown[1], &vg.been_shown[0], 7 * sizeof(vg.been_shown[0]));
+				vg.been_shown[0] = resource;
+			}
+		}
+		if (error == 0) {
+			vg.scanout_res = resource;
+		}
+	}
+	lck_mtx_unlock(&vgpu_lock);
+	return error;
+}
+
+void
+redwood_vgpu_forget(uint32_t resource)
+{
+	lck_mtx_lock(&vgpu_lock);
+	for (int i = 0; i < 8; i++) {
+		vg.been_shown[i] = vg.been_shown[i] == resource ? 0 : vg.been_shown[i];
+	}
+	lck_mtx_unlock(&vgpu_lock);
+}
