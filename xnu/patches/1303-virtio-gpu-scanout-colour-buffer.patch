+
+static int
+res_name(struct vopen *o, const struct vgpu3d_ioc_name *n)
+{
+	struct res *r = res_find(o, n->res);
+	int slot = -1;
+
+	if (r == NULL || n->sid == 0) {
+		return ENOENT;
+	}
+	lck_mtx_lock(&vgpu3d_opens_lock);
+	for (int i = 0; i < MAX_NAMED; i++) {
+		if (named[i].sid == n->sid || named[i].res == n->res) {
+			bzero(&named[i], sizeof(named[i]));
+		}
+		slot = slot < 0 && named[i].sid == 0 ? i : slot;
+	}
+	if (slot >= 0) {
+		named[slot].sid = n->sid;
+		named[slot].res = r->id;
+		named[slot].width = r->width;
+		named[slot].height = r->height;
+		named[slot].o = o;
+		named[slot].r = r;
+	}
+	lck_mtx_unlock(&vgpu3d_opens_lock);
+	return slot >= 0 ? 0 : ENOSPC;
+}
+
+int
