diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index 1161432..4bed8af 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1832,6 +1832,28 @@ proc_handle_critical_exit(proc_t p, int rv)
 	}
 }
 
+/*
+ * Boot-arg exitlog=1: a line for every process that ends on a signal or with a reason given by
+ * someone else (RunningBoard's terminations, jetsam, code signing...), "exit: NAME[PID] ...". A daemon
+ * or an extension that keeps dying shows up nowhere else when launchd's log is off or throttled.
+ */
+static TUNABLE(uint32_t, exit_log, "exitlog", 0);
+
+static void
+proc_exit_log(proc_t p, int rv)
+{
+	os_reason_t reason = p->p_exit_reason;
+	char *description;
+
+	if (!exit_log || (!WIFSIGNALED(rv) && reason == OS_REASON_NULL)) {
+		return;
+	}
+	description = reason != OS_REASON_NULL ? exit_reason_get_string_desc(reason) : NULL;
+	printf("exit: %s[%d] signal %d status %d, reason namespace %d code 0x%llx%s%s\n", p->p_comm, proc_getpid(p),
+	    WIFSIGNALED(rv) ? WTERMSIG(rv) : 0, WEXITSTATUS(rv), reason != OS_REASON_NULL ? reason->osr_namespace : -1,
+	    reason != OS_REASON_NULL ? reason->osr_code : 0, description ? ": " : "", description ? description : "");
+}
+
 void
 proc_prepareexit(proc_t p, int rv, boolean_t perf_notify)
 {
@@ -1845,6 +1867,7 @@ proc_prepareexit(proc_t p, int rv, boolean_t perf_notify)
 	int kr = 0;
 	int create_corpse = FALSE;
 
+	proc_exit_log(p, rv);
 	if (p->p_crash_behavior != 0 || p == initproc) {
 		proc_handle_critical_exit(p, rv);
 	}
